{
  "name": "seeker-workroom-functions",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": { "node": "22" },
  "scripts": {
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "test:rules": "tsx --test test/rules.integration.ts",
    "emulators": "firebase emulators:start --only auth,firestore,functions --project demo-workroom",
    "deploy": "firebase deploy --only functions,firestore:rules"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "firebase-admin": "13.5.0",
    "firebase-functions": "6.4.0",
    "tweetnacl": "1.0.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/node": "22.18.6",
    "firebase": "11.10.0",
    "firebase-tools": "14.16.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
