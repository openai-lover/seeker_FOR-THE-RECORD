# Configure before deploying. No wallet secrets are ever needed.
APP_DOMAIN=workroom.example.com
APP_URI=https://workroom.example.com
# Functions secret: firebase functions:secrets:set SOLANA_RPC_URL
# Mainnet endpoint with Token-2022 support; never expose an RPC API key in the APK.
PAYMENTS_ENABLED=false
# Public merchant wallet. Its SKR associated token account must exist.
MERCHANT_WALLET=
# Choose an explicit SKR integer base-unit amount. No USD conversion default.
SKR_AMOUNT_ATOMIC=
